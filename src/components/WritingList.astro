---
import { groupByYear, writingUrl, formatDate, CATEGORIES, LANGUAGES, type Writing } from '../lib/writings';

interface Props {
  items: Writing[];
}
const { items } = Astro.props;
const groups = groupByYear(items);
---

<div class="writing-list">
  {
    groups.map(([year, entries]) => (
      <section class="year" id={`year-${year}`} data-year>
        <h2 class="year-heading">{year}</h2>
        <ol>
          {entries.map((w) => (
            <li data-language={w.data.language} data-category={w.data.category}>
              <a href={writingUrl(w.id)} lang={w.data.language}>
                {w.data.title}
              </a>
              <span class="meta ui">
                <time datetime={w.data.date.toISOString()}>{formatDate(w.data.date)}</time>
                {w.data.category === 'story' && <span class="chip">{CATEGORIES.story.label}</span>}
                <span class="chip lang" lang={w.data.language}>
                  {LANGUAGES[w.data.language].native}
                </span>
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .year {
    margin-top: 2rem;
  }
  .year-heading {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.4rem;
    margin: 0 0 0.25rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.15rem 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }
  li[hidden] {
    display: none;
  }
  li > a {
    color: var(--ink);
    text-decoration: none;
    font-size: 1.1rem;
    flex: 1 1 16rem;
  }
  li > a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .meta {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  .chip.lang {
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
  }
  .meta .chip:lang(ne) {
    font-family: var(--font-deva);
  }
</style>
