---
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const links = [
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { label: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}` },
  { label: 'X', href: `https://x.com/intent/post?text=${t}&url=${u}` },
  { label: 'Email', href: `mailto:?subject=${t}&body=${u}` },
];
---

<div class="share ui" data-url={url} data-title={title}>
  <span class="label">Share</span>
  <button type="button" class="native" hidden>Share…</button>
  {
    links.map((l) => (
      <a href={l.href} target="_blank" rel="noopener">
        {l.label}
      </a>
    ))
  }
  <button type="button" class="copy">Copy link</button>
</div>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('.share')) {
    const { url = location.href, title = document.title } = el.dataset;
    const native = el.querySelector<HTMLButtonElement>('.native')!;
    if (navigator.share) {
      native.hidden = false;
      native.addEventListener('click', () => navigator.share({ title, url }).catch(() => {}));
    }
    const copy = el.querySelector<HTMLButtonElement>('.copy')!;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        copy.textContent = 'Copied ✓';
      } catch {
        copy.textContent = 'Copy failed';
      }
      setTimeout(() => (copy.textContent = 'Copy link'), 2000);
    });
  }
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }
  .label {
    color: var(--ink-faint);
    margin-right: 0.25rem;
  }
  a,
  button {
    font: inherit;
    color: var(--ink-soft);
    border: 1px solid var(--rule);
    background: transparent;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    text-decoration: none;
    cursor: pointer;
  }
  a:hover,
  button:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  button[hidden] {
    display: none;
  }
</style>
