---
import Base from '../layouts/Base.astro';
import WritingCard from '../components/WritingCard.astro';
import WritingGrid from '../components/WritingGrid.astro';
import { getWritings, AUTHOR, SITE_TAGLINE, LANGUAGES } from '../lib/writings';

const writings = await getWritings();
const [latest] = writings;
const count = (fn: (w: (typeof writings)[number]) => boolean) => writings.filter(fn).length;
const filters = [
  { value: 'all', label: 'All', n: writings.length },
  { value: 'language:en', label: LANGUAGES.en.native, n: count((w) => w.data.language === 'en') },
  { value: 'language:ne', label: LANGUAGES.ne.native, n: count((w) => w.data.language === 'ne'), lang: 'ne' },
  { value: 'category:poem', label: 'Poems', n: count((w) => w.data.category === 'poem') },
  { value: 'category:story', label: 'Stories', n: count((w) => w.data.category === 'story') },
];
---

<Base>
  <div class="wrap-wide">
    <section class="hero">
      <p class="eyebrow">Poems &amp; stories · English and <span lang="ne">नेपाली</span> · since 2009</p>
      <h1 class="tagline">“{SITE_TAGLINE}”</h1>
      <p class="byline">
        A diary of verse by <a href="/about/">{AUTHOR}</a> — on memory, home, displacement, freedom and the
        pursuit of happiness.
      </p>
    </section>

    {
      latest && (
        <section class="latest" aria-labelledby="latest-heading">
          <h2 id="latest-heading" class="section-label ui">Latest</h2>
          <WritingCard entry={latest} featured />
        </section>
      )
    }

    <div class="filter-bar">
      <h2 class="section-label ui">All writing</h2>
      <div class="filters ui" role="group" aria-label="Filter the writing" hidden>
        {
          filters.map((f) => (
            <button type="button" data-filter={f.value} aria-pressed={String(f.value === 'all')} lang={f.lang}>
              {f.label} <span>{f.n}</span>
            </button>
          ))
        }
      </div>
    </div>

    <WritingGrid items={writings} />
  </div>
</Base>

<script>
  const filters = document.querySelector<HTMLElement>('.filters');
  if (filters) {
    filters.hidden = false;
    const buttons = [...filters.querySelectorAll<HTMLButtonElement>('button')];
    const apply = (value: string) => {
      const [key, wanted] = value.split(':');
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === value));
      for (const card of document.querySelectorAll<HTMLElement>('.writing-grid .card')) {
        card.hidden = value !== 'all' && card.dataset[key] !== wanted;
      }
      for (const year of document.querySelectorAll<HTMLElement>('[data-year]')) {
        year.hidden = !year.querySelector('.card:not([hidden])');
      }
    };
    for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.filter!));
  }
</script>

<style>
  .hero {
    padding: 1.5rem 0 3rem;
    max-width: 52rem;
  }
  .tagline {
    font-size: clamp(2.1rem, 5.5vw, 3.6rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 0.75rem 0 1.25rem;
  }
  .byline {
    font-size: clamp(1.15rem, 2.2vw, 1.35rem);
    color: var(--ink-soft);
    margin: 0;
    max-width: 40rem;
  }
  .section-label {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 1rem;
  }
  .latest {
    margin-bottom: 3.5rem;
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .filter-bar .section-label {
    margin: 0;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filters[hidden] {
    display: none;
  }
  .filters button {
    font: inherit;
    font-size: 0.95rem;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    color: var(--ink-soft);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    cursor: pointer;
  }
  .filters button:hover {
    border-color: var(--ink-faint);
  }
  .filters button[lang='ne'] {
    font-family: var(--font-deva);
  }
  .filters button span {
    color: var(--ink-faint);
    margin-left: 0.2rem;
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .filters button[aria-pressed='true'] span {
    color: inherit;
    opacity: 0.7;
  }
</style>
