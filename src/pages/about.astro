---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Comments from '../components/Comments.astro';
import { excerpt } from '../lib/writings';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('src/content/pages/about.md is missing');
const { Content } = await render(page);
---

<Base title={page.data.title} description={excerpt(page.body, 2).join(' ')}>
  <article class="wrap">
    <h1>{page.data.title}</h1>
    <div class="about-body">
      <Content />
    </div>
    <Comments postId="about" />
  </article>
</Base>

<style>
  h1 {
    font-size: 2.2rem;
    margin: 0 0 1.5rem;
  }
  .about-body {
    font-size: 1.15rem;
  }
  .about-body :global(p:has(> img:only-child)) {
    float: left;
    max-width: 9rem;
    margin: 0.3rem 1.5rem 1rem 0;
  }
  .about-body :global(img) {
    border-radius: 4px;
  }
  .about-body::after {
    content: '';
    display: block;
    clear: both;
  }
</style>
