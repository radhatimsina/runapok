---
import '../styles/global.css';
import { SITE_TITLE, SITE_TAGLINE, AUTHOR, CATEGORIES, LANGUAGES, getMenuPages, pageUrl } from '../lib/writings';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  lang?: string;
}

const {
  title,
  description = SITE_TAGLINE,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  lang = 'en',
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} — poems and stories by ${AUTHOR}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const isDefaultImage = image === '/og-default.png';
const path = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'All writing' },
  { href: `/category/${CATEGORIES.poem.path}/`, label: 'Poems' },
  { href: `/category/${CATEGORIES.story.path}/`, label: 'Stories' },
  { href: `/language/${LANGUAGES.ne.path}/`, label: 'नेपाली', lang: 'ne' },
  // Pages the author marked "Show in the top menu" (About, Books, ...)
  ...(await getMenuPages()).map((p) => ({
    href: pageUrl(p.id),
    label: p.id === 'about' ? 'About' : p.data.title,
    lang: /[\u0900-\u097F]/.test(p.data.title) ? 'ne' : undefined,
  })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content={AUTHOR} />
    <meta name="theme-color" content="#faf7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1816" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {publishedTime && <meta property="article:author" content={AUTHOR} />}
    <meta name="twitter:card" content={isDefaultImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? SITE_TITLE} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip ui" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap-wide header-inner">
        <a class="brand" href="/">
          <img class="brand-logo" src="/logo.png" alt="" width="512" height="512" />
          <span class="brand-text">
            <span class="brand-title">{SITE_TITLE}</span>
            <span class="brand-author ui">{AUTHOR}</span>
          </span>
        </a>
        <button class="theme-toggle ui" type="button" aria-label="Switch colour theme" title="Switch colour theme">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"
            ></path></svg
          >
        </button>
      </div>
      <nav class="wrap-wide site-nav ui" aria-label="Main">
        {
          navItems.map((item: { href: string; label: string; lang?: string }) => (
            <a
              href={item.href}
              lang={item.lang}
              aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer ui">
      <div class="wrap-wide">
        <p>© {new Date().getFullYear()} {AUTHOR}. All poems and stories are the author’s own.</p>
        <p class="footer-links">
          <a href="/rss.xml">RSS feed</a><span aria-hidden="true">·</span><a href="/about/">About</a><span
            aria-hidden="true">·</span><a href="https://bhutaneseliterature.com" rel="noopener">Bhutanese Literature</a><span
            aria-hidden="true">·</span><a href="/admin/" rel="nofollow">Author login</a>
        </p>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    background: var(--paper-raised);
    padding: 0.5rem 0.75rem;
    z-index: 10;
  }
  .skip:focus {
    left: 0.5rem;
  }
  .site-header {
    border-bottom: 1px solid var(--rule);
    padding-top: 1.75rem;
  }
  .header-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    color: var(--ink);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
  }
  .brand-logo {
    width: clamp(3rem, 6.5vw, 3.8rem);
    height: auto;
    flex-shrink: 0;
    border-radius: 22%;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.12);
  }
  .brand-title {
    font-size: clamp(1.8rem, 4vw, 2.3rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .brand-author {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: 0.25rem;
  }
  .theme-toggle {
    background: none;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    cursor: pointer;
    flex-shrink: 0;
  }
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding-top: 1.1rem;
    padding-bottom: 1rem;
    font-size: 1.05rem;
  }
  .site-nav a {
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.15rem 0;
    border-bottom: 2px solid transparent;
  }
  .site-nav a:hover {
    color: var(--ink);
  }
  .site-nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  main {
    padding: 2.5rem 0 5rem;
  }
  .site-footer {
    border-top: 1px solid var(--rule);
    color: var(--ink-faint);
    font-size: 0.9rem;
    padding: 2rem 0 3rem;
  }
  .site-footer p {
    margin: 0.25rem 0;
  }
  .site-footer a {
    color: var(--ink-soft);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
  }
</style>
