# Added automatically when you connect a Neon database in Vercel → Storage.
DATABASE_URL=

# GitHub OAuth app for the /admin writing desk (see README).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Lets the author reply to comments marked as "Author". Choose any long phrase.
AUTHOR_PASSCODE=

# Optional: any random text, used to anonymise visitor IPs for rate limiting.
COMMENT_SALT=

# Optional: set to "true" to hold every new comment until approved.
COMMENTS_REQUIRE_APPROVAL=false
